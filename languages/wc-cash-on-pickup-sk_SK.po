#: classes/class.wc-cop-blocks.php:161
#: classes/class.wc-cop.php:246
#: classes/class.wc-cop.php:391
msgid "Cash on pickup"
msgstr "Platba v hotovosti"

#: classes/class.wc-cop.php:247
msgid "Have your customers pay with cash (or by other means) on pickup."
msgstr "Platba v hotovosti pri vyzdvihnutí tovaru na predajni."

#: classes/class.wc-cop.php:382
msgid "Enable cash on pickup"
msgstr "Povoliť platbu v hotovosti"

#: classes/class.wc-cop.php:398
#: classes/class.wc-cop.php:405
msgid "Pay with cash on pickup."
msgstr "Platba v hotovosti pri vyzdvihnutí tovaru."

#: classes/class.wc-cop.php:414
msgid "If COP is only available for certain methods, set it up here. Leave blank to enable for all methods."
msgstr "Ak má byť platba v hotovosti dostupná iba pre niektoré spôsoby doručenia, nastavte ich tu. Nechajte nevyplnené pre všetky spôsoby."

#: classes/class.wc-cop.php:422
msgid "Default order status"
msgstr "Predvolený stav objednávky"

#: classes/class.wc-cop.php:436
msgid "Accept COP if the order is virtual"
msgstr "Povoliť platbu v hotovosti pri virtuálnych produktoch"

#: wc-cash-on-pickup.php:89
msgid "Donate"
msgstr "Prispejte"

#. Plugin URI of the plugin
#: wc-cash-on-pickup.php
msgid "https://wordpress.org/plugins/wc-cash-on-pickup/"
msgstr "https://wordpress.org/plugins/wc-cash-on-pickup/"

#. Author of the plugin
#: wc-cash-on-pickup.php
msgid "Marian Kadanka"
msgstr "Marian Kadanka"

#. Plugin Name of the plugin
#: wc-cash-on-pickup.php
msgid "Cash On Pickup for WooCommerce"
msgstr "Platba v hotovosti pri osobnom odbere pre WooCommerce"

#. Description of the plugin
#: wc-cash-on-pickup.php
msgid "A WooCommerce Extension that adds the payment gateway \"Cash On Pickup\". Supports both the classic and the block based checkout."
msgstr "WooCommerce plugin pridávajúci spôsob platby v hotovosti pri osobnom odbere. Podporuje klasickú aj blokovú pokladňu."

#. Author URI of the plugin
#: wc-cash-on-pickup.php
msgid "https://kadanka.net/"
msgstr "https://kadanka.net/"

#: classes/class.wc-cop.php:428
msgid "Disable other payment methods for local pickup"
msgstr "Zakázať ostatné spôsoby platby pri osobnom odbere"

#: classes/class.wc-cop.php:429
msgid "Make cash on pickup the only payment method when local pickup is selected at checkout"
msgstr "Nastaviť platbu v hotovosti ako jediný spôsob platby, ak je v pokladni zvolený osobný odber"

#: classes/class.wc-cop.php:617
msgid "Payment to be made upon pickup."
msgstr "Platba bude uhradená pri osobnom odbere."
